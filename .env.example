# Copy to .env.local and fill in. Without TRADIER_TOKEN the app runs on simulated data.

# Tradier market data (options chains, greeks, quotes). https://developer.tradier.com
TRADIER_TOKEN=
# "live" = real-time with a funded brokerage account, "sandbox" = 15-min delayed, free
TRADIER_ENV=sandbox

# Finnhub (earnings calendar, company news). Optional. https://finnhub.io
FINNHUB_API_KEY=

# AI, cheapest first: free Gemini models, then a paid Gemini key, then Claude as the last resort.
GEMINI_API_KEY=
# Optional: a key from a billing-enabled Google project, used only after the free models run out.
GEMINI_PAID_API_KEY=
ANTHROPIC_API_KEY=
# Set to "off" to never use Claude, even when every Gemini model is unavailable.
# CLAUDE_FALLBACK=off
# Optional model lists (comma-separated, tried in order) and Claude models.
# GEMINI_JUDGE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-pro-latest,gemini-3.5-flash,gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_CHAT_MODEL=claude-opus-5-5

# Read-only brokerage balances and option positions through SnapTrade (personal API key).
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Phone alerts through ntfy (optional). Subscribe to this topic in the ntfy app; keep it long and random.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Sign-in (optional) ---------------------------------------------------------
# Google sign-in turns on when all three are set. Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials with the redirect URI
#   http://localhost:3000/api/auth/callback
# The first Google account to sign in becomes the owner; nobody else is admitted unless listed below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string; changing it signs everyone out.
AUTH_SECRET=
# Optional: comma-separated emails allowed to sign in (default: only the owner).
# ALLOWED_EMAILS=
# Optional: the public address when the app is not on localhost, e.g. https://strike.example.com
# APP_URL=
